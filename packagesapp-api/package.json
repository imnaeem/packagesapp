{
  "name": "packagesapp-api",
  "version": "1.0.0",
  "description": "Pakistan Telecom Packages REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node --openssl-legacy-provider dist/server.js",
    "lint": "tsc --noEmit",
